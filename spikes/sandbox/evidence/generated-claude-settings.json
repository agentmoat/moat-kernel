{
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "excludedCommands": [],
    "filesystem": {
      "denyRead": [
        "~/.ssh/**",
        "~/.aws/**",
        "~/.gnupg/**",
        "~/.config/gh/**",
        "~/.netrc",
        "~/.docker/config.json",
        "~/.kube/**",
        "~/.config/gcloud/**",
        "~/.azure/**",
        "~/.git-credentials",
        "~/.npmrc",
        "~/.pypirc",
        "~/.cargo/credentials",
        "~/.cargo/credentials.toml",
        "~/.zsh_history",
        "~/.bash_history",
        "/**/.env",
        "/**/.env.*",
        "/**/.envrc",
        "~/Library/Keychains/**"
      ],
      "allowRead": [
        "/**/.env.example",
        "/**/.env.sample",
        "/**/.env.template"
      ],
      "denyWrite": [
        "~/.ssh/**",
        "~/.aws/**",
        "~/.gnupg/**",
        "~/.config/gh/**",
        "~/.netrc",
        "~/.docker/config.json",
        "~/.kube/**",
        "~/.config/gcloud/**",
        "~/.azure/**",
        "~/.git-credentials",
        "~/.npmrc",
        "~/.pypirc",
        "~/.cargo/credentials",
        "~/.cargo/credentials.toml",
        "~/.zsh_history",
        "~/.bash_history",
        "/**/.env",
        "/**/.env.*",
        "/**/.envrc",
        "~/Library/Keychains/**",
        "~/.moat/**",
        "~/.claude/settings.json",
        "~/.claude/settings.local.json",
        "~/.codex/**",
        "~/.cursor/hooks.json",
        "/**/.claude/settings.json",
        "/**/.claude/settings.local.json",
        "/**/.cursor/hooks.json",
        "/**/.codex/hooks.json",
        "/**/.moat/**",
        "/**/bin/moat",
        "/**/bin/moat.exe",
        "~/.zshrc",
        "~/.bashrc",
        "~/.bash_profile",
        "~/.profile",
        "~/.zprofile",
        "~/.zshenv"
      ]
    },
    "network": {
      "allowedDomains": [
        "api.github.com",
        "github.com",
        "registry.npmjs.org",
        "crates.io",
        "static.crates.io",
        "index.crates.io",
        "proxy.golang.org",
        "pypi.org",
        "files.pythonhosted.org"
      ],
      "deniedDomains": [
        "fd00:ec2::254",
        "100.100.100.200",
        "metadata.google.internal",
        "metadata.goog"
      ],
      "strictAllowlist": true
    }
  }
}
